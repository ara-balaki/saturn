#!/bin/sh
# Codex runs this as each of its turns ends (the `notify` of Saturn's Codex profile), with the turn
# as JSON in $1: its session's id, folder and last answer. It goes to the Saturn window the session
# runs in. Outside Saturn it does nothing.
[ -n "$SATURN_SOCKET" ] && [ -S "$SATURN_SOCKET" ] || exit 0
printf '%s' "$1" | curl --silent --max-time 2 --unix-socket "$SATURN_SOCKET" \
  --header 'Content-Type: application/json' --data-binary @- \
  "http://saturn/hook?pane=${SATURN_PANE_ID}&agent=codex" >/dev/null 2>&1
exit 0
